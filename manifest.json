{
  "id": "kakunin",
  "name": "KAKUNIN 確認",
  "kanji": "確認",
  "description": "Hỏi xác nhận trước khi đóng cửa sổ được bảo vệ. Exit code 0 = yes, 1 = no.",
  "version": "1.1.0",
  "kind": "oneshot",
  "requires_lib": ">=1.2 <2.0",
  "config_version": 1,
  "run": "quickshell -p {dir}/shell.qml",
  "ipc_target": "sumi-kakunin",
  "functions": [
    { "id": "confirm", "label": "CONFIRM", "objects": [] }
  ],
  "options": [
    { "key": "acceptKeysDelayMs", "type": "int", "default": 180, "min": 0, "max": 1000, "label": "KEY GUARD MS" },
    { "key": "crtBootMs", "type": "int", "default": 800, "min": 0, "max": 3000, "label": "CRT BOOT MS" },
    { "key": "crtOutroMs", "type": "int", "default": 460, "min": 0, "max": 3000, "label": "CRT OUTRO MS" }
  ],
  "keybinds": [
    { "action": "yes", "default": "Y", "label": "YES" },
    { "action": "no", "default": "N", "label": "NO" },
    { "action": "nav.left", "default": "A", "label": "LEFT" },
    { "action": "nav.right", "default": "D", "label": "RIGHT" },
    { "action": "confirm", "default": "Return", "label": "CONFIRM" },
    { "action": "cancel", "default": "Escape", "label": "CANCEL", "locked": true }
  ],
  "fonts": ["title", "label", "data"],
  "requires": [],
  "shell_commands": []
}
